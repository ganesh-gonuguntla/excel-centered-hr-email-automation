# ===================================================================
# SMTP Credentials (NEVER commit this file!)
# ===================================================================
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password (16 characters, no spaces)
#   4. Paste it below as SMTP_APP_PASSWORD
#
# SMTP_USER is your full Gmail address.
# SMTP_APP_PASSWORD is the 16-character app password (NOT your login password).

SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
